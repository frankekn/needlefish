{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/frankekn/needlefish/main/schemas/review-result.v1.schema.json",
  "title": "Needlefish ReviewResult (schemaVersion 1)",
  "description": "The object `needlefish --json` and `needlefish pr <number> --json` print to stdout, and the local cache stores as last-review.json. Within a schemaVersion fields are only added, never changed or removed, so unknown properties are allowed.",
  "type": "object",
  "required": [
    "schemaVersion",
    "verdict",
    "summary",
    "findings",
    "checked",
    "residualRisks",
    "baseSha",
    "headSha"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verdict": {
      "description": "Derived deterministically from findings and residualRisks.",
      "enum": ["pass", "changes_requested", "needs_human"]
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "checked": {
      "description": "Evidence strings describing what the review examined.",
      "type": "array",
      "items": { "type": "string" }
    },
    "residualRisks": {
      "type": "array",
      "items": { "$ref": "#/$defs/residualRisk" }
    },
    "baseSha": {
      "description": "The merge base the diff was taken from.",
      "type": "string"
    },
    "headSha": { "type": "string" },
    "reviewTarget": { "type": "string" },
    "docsOnlyFastPath": {
      "description": "Set by the review pipeline when docs-only policy skips all model calls. Never supplied by a model.",
      "type": "boolean"
    },
    "prNumber": {
      "description": "Present for `needlefish pr <number>`.",
      "type": "integer",
      "minimum": 1
    },
    "prBaseSha": {
      "description": "The PR base branch tip, distinct from baseSha.",
      "type": "string"
    },
    "scopeCallouts": {
      "description": "Non-blocking callouts naming changed files on sensitive surfaces, derived from paths only.",
      "type": "array",
      "items": { "$ref": "#/$defs/scopeCallout" }
    },
    "coverageGaps": {
      "description": "Changed files whose contents the review could not read. lfs_pointer_only names a file the sandbox could only check out as a Git LFS pointer stub; at most one lfs_scan_incomplete entry means the sandbox could not establish the full pointer list. Reported by the sandbox, never by the model; does not affect the verdict.",
      "type": "array",
      "items": { "$ref": "#/$defs/coverageGap" }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "unreviewedBinaryFiles": {
      "description": "Repo-relative paths Git classified as binary whose contents were not reviewed. Paths also listed as LFS pointer gaps are omitted. Output-only and non-blocking.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stats": {
      "description": "Per-runner-call timing and attempt stats.",
      "type": "array",
      "items": { "$ref": "#/$defs/runStat" }
    },
    "totalDurationMs": { "type": "number" },
    "coverage": {
      "description": "One-line coverage summary for large-diff reviews.",
      "type": "string"
    },
    "candidateFindings": {
      "description": "Eval tracing only (NEEDLEFISH_EVAL_TRACE=1): findings before the critic pass.",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "failedRawOutputs": {
      "description": "Eval tracing only (NEEDLEFISH_EVAL_TRACE=1).",
      "type": "array",
      "items": { "type": "string" }
    },
    "rawOutputs": {
      "description": "Eval tracing only (NEEDLEFISH_EVAL_TRACE=1).",
      "type": "array",
      "items": { "type": "string" }
    },
    "traceDeliveryFailed": {
      "description": "Eval tracing only: true when a trace observer threw.",
      "type": "boolean"
    }
  },
  "$defs": {
    "runtimeValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "enum": [
                "known",
                "operator_attested"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "required": [
        "coreVersion",
        "sourceSha",
        "runnerVersion",
        "launcherDigest",
        "model",
        "effort",
        "promptHash",
        "runner",
        "callTimeoutMs",
        "reviewBudgetMs",
        "qualification"
      ],
      "properties": {
        "coreVersion": {
          "$ref": "#/$defs/runtimeValue"
        },
        "sourceSha": {
          "$ref": "#/$defs/runtimeValue"
        },
        "runnerVersion": {
          "$ref": "#/$defs/runtimeValue"
        },
        "launcherDigest": {
          "$ref": "#/$defs/runtimeValue"
        },
        "model": {
          "$ref": "#/$defs/runtimeValue"
        },
        "effort": {
          "$ref": "#/$defs/runtimeValue"
        },
        "promptHash": {
          "$ref": "#/$defs/runtimeValue"
        },
        "runner": {
          "enum": [
            "codex",
            "claude",
            "opencode",
            "grok",
            "pi",
            "acp",
            "openai"
          ]
        },
        "callTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reviewBudgetMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "qualification": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "matchStatus"
              ],
              "additionalProperties": false,
              "properties": {
                "matchStatus": {
                  "const": "unqualified"
                },
                "reason": {
                  "enum": [
                    "missing_report",
                    "report_not_admitted",
                    "quality_gate_failed",
                    "different_configuration",
                    "unknown_identity"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "matchStatus",
                "policyVersion",
                "reportId"
              ],
              "additionalProperties": false,
              "properties": {
                "matchStatus": {
                  "const": "tested"
                },
                "policyVersion": {
                  "const": "public-leaderboard-interim-v1"
                },
                "reportId": {
                  "type": "string",
                  "pattern": "^results/[A-Za-z0-9._-]+\\.json$"
                }
              }
            }
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "title",
        "category",
        "file",
        "lineStart",
        "lineEnd",
        "confidence",
        "whyItBreaks",
        "suggestedFix",
        "validation"
      ],
      "properties": {
        "severity": {
          "description": "P0-P2 block merge; P3 is reported but never blocks.",
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["bug", "contract", "duplicate", "runtime", "security", "validation"]
        },
        "file": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "number", "exclusiveMinimum": 0 },
        "lineEnd": {
          "description": "Never less than lineStart.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "whyItBreaks": { "type": "string", "minLength": 1 },
        "suggestedFix": { "type": "string", "minLength": 1 },
        "validation": { "type": "string" },
        "consumerFile": {
          "description": "Downstream file affected by the finding.",
          "type": "string",
          "minLength": 1
        },
        "consumerLine": {
          "description": "Downstream line affected by the finding.",
          "type": "number",
          "not": { "const": 0 }
        },
        "replacement": {
          "description": "Exact replacement for lines lineStart..lineEnd, one string per line.",
          "type": "object",
          "required": ["lines"],
          "properties": {
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[^\\r\\n]*$" }
            }
          }
        },
        "quote": {
          "description": "One source line the finding describes, copied by the reviewer, with leading and trailing whitespace trimmed.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\r\\n]*$"
        },
        "quoteCheck": {
          "description": "Needlefish's check of quote against the reviewed tree. Never affects the verdict.",
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["matched", "moved", "not_found", "unchecked"] },
            "from": {
              "description": "Original file:line when status is moved.",
              "type": "string",
              "minLength": 1
            }
          },
          "if": { "properties": { "status": { "const": "moved" } }, "required": ["status"] },
          "then": { "required": ["from"], "properties": { "from": {} } }
        },
        "externalClaims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalClaim"
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "toolRead",
            "sources"
          ],
          "properties": {
            "toolRead": {
              "const": "unknown"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceEvidence"
              }
            }
          }
        }
      },
      "if": {
        "required": ["severity"],
        "properties": { "severity": { "enum": ["P0", "P1", "P2"] } }
      },
      "then": {
        "properties": { "confidence": { "type": "number", "minimum": 0.7 } }
      }
    },
    "residualRisk": {
      "type": "object",
      "required": ["text", "blocks"],
      "properties": {
        "text": { "type": "string" },
        "blocks": {
          "description": "true makes the verdict at least needs_human.",
          "type": "boolean"
        }
      }
    },
    "coverageGap": {
      "oneOf": [
        { "$ref": "#/$defs/lfsPointerOnlyGap" },
        { "$ref": "#/$defs/lfsScanIncompleteGap" }
      ]
    },
    "lfsPointerOnlyGap": {
      "type": "object",
      "required": ["kind", "file"],
      "properties": {
        "kind": { "const": "lfs_pointer_only" },
        "file": { "description": "Repo-relative path of a changed file.", "type": "string", "minLength": 1 }
      }
    },
    "lfsScanIncompleteGap": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "lfs_scan_incomplete" }
      }
    },
    "scopeCallout": {
      "type": "object",
      "required": ["surface", "files"],
      "properties": {
        "surface": {
          "enum": ["dependency", "schema", "workflow", "config", "public-api"]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runStat": {
      "type": "object",
      "required": ["label", "runner", "durationMs", "attempts", "ok"],
      "properties": {
        "label": { "type": "string" },
        "runner": {
          "enum": ["codex", "claude", "opencode", "openai", "grok", "pi", "acp"]
        },
        "model": { "type": "string" },
        "durationMs": { "type": "number" },
        "attempts": { "type": "integer", "minimum": 1 },
        "ok": { "type": "boolean" },
        "usage": { "$ref": "#/$defs/runUsage" }
      }
    },
    "runUsage": {
      "type": "object",
      "required": ["totalTokens", "inputTokens", "outputTokens"],
      "properties": {
        "totalTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "inputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "outputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "externalClaim": {
      "type": "object",
      "required": [
        "claim",
        "necessary",
        "source"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "pattern": "\\S"
        },
        "necessary": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "external"
            },
            "url": {
              "type": "string",
              "description": "Structural HTTP(S) URL contract for normalized output: nonempty host, bracketed IP literal, no userinfo, and an optional decimal port from 0 through 65535 without leading zeros. This does not validate full IP or IDNA semantics; the persisted parser must also validate with WHATWG URL and reject credentials. Schema validation alone is not full admission.",
              "pattern": "^https?://(?:[^\\s:/?#@\\[\\]\\\\]+|\\[[0-9A-Fa-f:.]+\\])(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#].*)?$"
            }
          }
        }
      }
    },
    "sourceEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sourceType",
            "revision",
            "file",
            "lineStart",
            "lineEnd",
            "status"
          ],
          "properties": {
            "sourceType": {
              "const": "git_blob"
            },
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "lineStart": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lineEnd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "status": {
              "enum": [
                "source_present",
                "source_unverified"
              ]
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "source_present"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "contentDigest"
            ],
            "properties": {
              "contentDigest": {},
              "revision": {
                "type": "string"
              },
              "lineStart": {
                "type": "integer"
              },
              "lineEnd": {
                "type": "integer"
              }
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/externalClaim"
            },
            {
              "type": "object",
              "required": [
                "sourceType",
                "status"
              ],
              "properties": {
                "sourceType": {
                  "const": "external"
                },
                "status": {
                  "const": "unverified_external_claim"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
