#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
head=$(git rev-parse HEAD)
seen=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    HEAD|refs/heads/*) ;;
    *) echo "Needlefish gate blocked: push a branch ref." >&2; exit 1 ;;
  esac
  case "$remote_ref" in
    refs/heads/*) ;;
    *) echo "Needlefish gate blocked: push a branch ref." >&2; exit 1 ;;
  esac
  if [ "$local_sha" != "$head" ]; then
    echo "Needlefish gate blocked: push only the checked-out HEAD with this hook." >&2
    exit 1
  fi
  seen=1
done
if [ "$seen" -eq 0 ]; then
  exit 0
fi
cd "$root"
NEEDLEFISH_SHIFT_LEFT_EXPECTED_HEAD=$head exec node .needlefish/shift-left/review-gate.mjs origin/main
